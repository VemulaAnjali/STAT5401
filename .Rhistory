ggplot(yearly, aes(x = factor(Year), y = Offenses, fill = factor(Year))) +
geom_col(width = 0.6, show.legend = FALSE) +
geom_text(aes(label = scales::comma(Offenses)), vjust = -0.4, size = 3.5) +
