daily_tp <- offenses %>%
count(date, time_period, name = "n") %>%
pivot_wider(names_from = time_period, values_from = n, values_fill = 0) %>%
# Ensure all four columns exist
mutate(
Morning   = if ("Morning"   %in% names(.)) Morning   else 0,
Afternoon = if ("Afternoon" %in% names(.)) Afternoon else 0,
Evening   = if ("Evening"   %in% names(.)) Evening   else 0,
Night     = if ("Night"     %in% names(.)) Night     else 0
) %>%
select(date, Morning, Afternoon, Evening, Night)
# Numeric matrix for multivariate analysis
X <- as.matrix(daily_tp[, c("Morning", "Afternoon", "Evening", "Night")])
n <- nrow(X)   # number of days
p <- ncol(X)   # number of variables (time periods)
x_bar <- colMeans(X)
S     <- cov(X)
cat("Sample size (days):", n, "\n")
cat("\nSample mean vector (avg daily incidents per period):\n")
round(x_bar, 3)
summary_df <- data.frame(
Period    = names(x_bar),
Mean      = round(x_bar, 2),
SD        = round(apply(X, 2, sd), 2),
Min       = apply(X, 2, min),
Max       = apply(X, 2, max)
)
knitr::kable(summary_df,
caption = "Summary Statistics: Daily Incident Counts by Time Period",
row.names = FALSE)
alpha <- 0.05
t_crit <- qt(1 - alpha/2, df = n - 1)
t_ci <- data.frame(
Period    = colnames(X),
Mean      = round(x_bar, 3),
SE        = round(apply(X, 2, sd) / sqrt(n), 3),
Lower     = round(x_bar - t_crit * apply(X, 2, sd) / sqrt(n), 3),
Upper     = round(x_bar + t_crit * apply(X, 2, sd) / sqrt(n), 3)
)
cat("t critical value (df =", n-1, "):", round(t_crit, 4), "\n\n")
knitr::kable(t_ci,
caption = "Classical 95% t Confidence Intervals for Mean Daily Incidents",
row.names = FALSE)
# Hotelling T^2 statistic
T2 <- n * t(x_bar) %*% solve(S) %*% x_bar
# F critical value
F_crit <- qf(1 - alpha, df1 = p, df2 = n - p)
T2_crit <- (p * (n - 1)) / (n - p) * F_crit
cat("Hotelling T^2 statistic:", round(T2, 3), "\n")
cat("T^2 critical value:", round(T2_crit, 3), "\n")
cat("F critical value F(", p, ",", n-p, "):", round(F_crit, 4), "\n\n")
# Simultaneous CIs from Hotelling (projections of the ellipsoid onto each axis)
hot_half_width <- sqrt(T2_crit / n * diag(S))
hot_ci <- data.frame(
Period = colnames(X),
Mean   = round(x_bar, 3),
Lower  = round(x_bar - hot_half_width, 3),
Upper  = round(x_bar + hot_half_width, 3),
Width  = round(2 * hot_half_width, 3)
)
knitr::kable(hot_ci,
caption = paste0("Hotelling T² Simultaneous 95% Confidence Intervals",
" (Ellipsoid Projections)"),
row.names = FALSE)
alpha_bonf <- alpha / p   # Bonferroni-corrected level per interval
t_bonf     <- qt(1 - alpha_bonf/2, df = n - 1)
bonf_hw <- t_bonf * apply(X, 2, sd) / sqrt(n)
bonf_ci <- data.frame(
Period = colnames(X),
Mean   = round(x_bar, 3),
Lower  = round(x_bar - bonf_hw, 3),
Upper  = round(x_bar + bonf_hw, 3),
Width  = round(2 * bonf_hw, 3)
)
cat("Bonferroni-adjusted alpha per interval:", round(alpha_bonf, 4), "\n")
cat("Bonferroni t critical value:", round(t_bonf, 4), "\n\n")
knitr::kable(bonf_ci,
caption = "Bonferroni Simultaneous 95% Confidence Intervals",
row.names = FALSE)
comparison <- data.frame(
Period    = colnames(X),
t_Lower   = t_ci$Lower,
t_Upper   = t_ci$Upper,
t_Width   = t_ci$Upper - t_ci$Lower,
Hot_Lower = hot_ci$Lower,
Hot_Upper = hot_ci$Upper,
Hot_Width = hot_ci$Upper - hot_ci$Lower,
Bon_Lower = bonf_ci$Lower,
Bon_Upper = bonf_ci$Upper,
Bon_Width = bonf_ci$Upper - bonf_ci$Lower
)
knitr::kable(comparison,
caption = "Side-by-Side Comparison of All Three CI Methods",
digits = 3,
row.names = FALSE)
# Stack all CIs for plotting
ci_long <- bind_rows(
t_ci    %>% mutate(Method = "Classical t"),
hot_ci  %>% mutate(Method = "Hotelling T²"),
bonf_ci %>% mutate(Method = "Bonferroni")
) %>%
mutate(
Period = factor(Period, levels = c("Morning","Afternoon","Evening","Night")),
Method = factor(Method, levels = c("Classical t", "Bonferroni", "Hotelling T²"))
)
ggplot(ci_long, aes(x = Period, y = Mean, color = Method,
ymin = Lower, ymax = Upper)) +
geom_errorbar(aes(ymin = Lower, ymax = Upper),
position = position_dodge(width = 0.5), width = 0.25, linewidth = 0.9) +
geom_point(position = position_dodge(width = 0.5), size = 3) +
scale_color_manual(values = c("Classical t" = "#2A9D8F",
"Bonferroni"   = "#E9C46A",
"Hotelling T²" = "#E76F51")) +
labs(title = "95% Confidence Intervals: Mean Daily Incidents by Time Period",
subtitle = "Three methods compared — Classical t, Bonferroni, and Hotelling T²",
x = "Time Period", y = "Mean Daily Incidents",
color = "Method") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
width_long <- bind_rows(
data.frame(Period = colnames(X), Width = comparison$t_Width,   Method = "Classical t"),
data.frame(Period = colnames(X), Width = comparison$Hot_Width,  Method = "Hotelling T²"),
data.frame(Period = colnames(X), Width = comparison$Bon_Width,  Method = "Bonferroni")
) %>%
mutate(
Period = factor(Period, levels = c("Morning","Afternoon","Evening","Night")),
Method = factor(Method, levels = c("Classical t","Bonferroni","Hotelling T²"))
)
ggplot(width_long, aes(x = Period, y = Width, fill = Method)) +
geom_col(position = position_dodge(width = 0.65), width = 0.55) +
scale_fill_manual(values = c("Classical t" = "#2A9D8F",
"Bonferroni"   = "#E9C46A",
"Hotelling T²" = "#E76F51")) +
labs(title = "CI Width by Method and Time Period",
x = "Time Period", y = "Interval Width (incidents/day)",
fill = "Method") +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
# Sub-matrix for Afternoon and Evening
idx <- c("Afternoon", "Evening")
x2  <- x_bar[idx]
S2  <- S[idx, idx]
# Ellipse data using the ellipse package
T2_2   <- (2 * (n - 1)) / (n - 2) * qf(0.95, 2, n - 2)
ell_df <- as.data.frame(
ellipse::ellipse(S2 / n, centre = x2, t = sqrt(T2_2))
)
names(ell_df) <- c("Afternoon", "Evening")
# Sample cloud (random 500 for readability)
set.seed(42)
sample_idx <- sample(nrow(daily_tp), min(500, nrow(daily_tp)))
cloud <- daily_tp[sample_idx, c("Afternoon","Evening")]
ggplot() +
geom_point(data = cloud, aes(x = Afternoon, y = Evening),
alpha = 0.2, color = "#264653", size = 1) +
geom_path(data = ell_df, aes(x = Afternoon, y = Evening),
color = "#E76F51", linewidth = 1.2) +
geom_point(aes(x = x2["Afternoon"], y = x2["Evening"]),
color = "#E76F51", size = 4, shape = 18) +
labs(title = "Hotelling 95% Confidence Ellipse: Afternoon vs. Evening Incidents",
subtitle = "Diamond = sample mean; ellipse = joint 95% confidence region",
x = "Mean Daily Afternoon Incidents",
y = "Mean Daily Evening Incidents") +
theme_minimal(base_size = 12)
