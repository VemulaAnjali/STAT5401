clear
knitr::opts_chunk$set(echo = TRUE)
# Define covariance submatrices
Sigma11 <- matrix(c(100, 0,
0,   1), nrow = 2, byrow = TRUE)
Sigma22 <- matrix(c(1,   0,
0, 100), nrow = 2, byrow = TRUE)
Sigma12 <- matrix(c(0,    0,
0.95, 0), nrow = 2, byrow = TRUE)
# Extract variances
var_U1 <- Sigma11[2, 2]   # Var(X2^(1))
var_V1 <- Sigma22[1, 1]   # Var(X1^(2))
# Extract covariance
cov_U1_V1 <- Sigma12[2, 1]
# Compute correlation
rho1 <- cov_U1_V1 / sqrt(var_U1 * var_V1)
# Print results
cat("Var(U1):", var_U1, "\n")
cat("Var(V1):", var_V1, "\n")
cat("Cov(U1, V1):", cov_U1_V1, "\n")
cat("Canonical Correlation (rho1*):", rho1, "\n")
# Define correlation matrix
R <- matrix(c(
1.0,   0.615, -0.111, -0.266,
0.615, 1.0,   -0.195, -0.085,
-0.111,-0.195,  1.0,   -0.269,
-0.266,-0.085, -0.269,  1.0
), nrow = 4, byrow = TRUE)
# Partition the matrix
R11 <- R[1:2, 1:2]
R22 <- R[3:4, 3:4]
R12 <- R[1:2, 3:4]
R21 <- t(R12)
# Compute canonical correlation matrix
library(MASS)
R11_inv <- solve(R11)
R22_inv <- solve(R22)
M <- R11_inv %*% R12 %*% R22_inv %*% R21
# Eigen decomposition
eig <- eigen(M)
# Canonical correlations
canonical_corrs <- sqrt(eig$values)
cat("Canonical correlations:\n")
print(canonical_corrs)
# First canonical correlation
rho1 <- canonical_corrs[1]
cat("\nFirst canonical correlation:", rho1, "\n")
a1 <- eig$vectors[,1]
b1 <- solve(R22) %*% R21 %*% a1
b1 <- b1 / sqrt(t(b1) %*% R22 %*% b1)  # normalizing
a1 <- eig$vectors[,1]
b1 <- solve(R22) %*% R21 %*% a1
b1 <- as.vector(b1)
norm_factor <- sqrt(as.numeric(t(b1) %*% R22 %*% b1))
b1 <- b1 / norm_factor
cat("\na1 (coefficients for U1):\n")
print(a1)
cat("\nb1 (coefficients for V1):\n")
print(b1)
# Data
mu1 <- c(3, 6)
mu2 <- c(5, 8)
S <- matrix(c(1,1,
1,2), nrow=2, byrow=TRUE)
# Inverse of pooled covariance
S_inv <- solve(S)
S_inv
# Linear coefficients
w1 <- S_inv %*% mu1
w2 <- S_inv %*% mu2
c1 <- -0.5 * t(mu1) %*% S_inv %*% mu1
c2 <- -0.5 * t(mu2) %*% S_inv %*% mu2
# Discriminant functions
delta1 <- function(x) t(x) %*% w1 + c1
delta2 <- function(x) t(x) %*% w2 + c2
# New observation
x0 <- c(2, 7)
d1 <- delta1(x0)
d2 <- delta2(x0)
d1
d2
# Classification
if(d1 > d2){
"Class 1"
} else {
"Class 2"
}
0.7*150
X1 <- matrix(c(3,7,
2,4,
4,7), ncol=2, byrow=TRUE)
X2 <- matrix(c(6,9,
5,7,
4,8), ncol=2, byrow=TRUE)
mu1 <- colMeans(X1)
mu2 <- colMeans(X2)
S1 <- cov(X1)
S2 <- cov(X2)
n1 <- nrow(X1)
n2 <- nrow(X2)
Spooled <- ((n1-1)*S1 + (n2-1)*S2)/(n1+n2-2)
S_inv <- solve(Spooled)
delta <- function(x, mu) {
t(x) %*% S_inv %*% mu - 0.5 * t(mu) %*% S_inv %*% mu
}
X <- rbind(X1, X2)
group <- factor(c(rep(1,n1), rep(2,n2)))
pred <- apply(X, 1, function(x){
d1 <- delta(x, mu1)
d2 <- delta(x, mu2)
ifelse(d1 > d2, 1, 2)
})
table(Actual = group, Predicted = pred)
# APER
mean(pred != group)
